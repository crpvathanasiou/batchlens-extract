APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Optional — required only when composing a real OpenAI-backed LLM client
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# Optional document feature. Off by default; no AWS clients at module import.
DOCUMENT_CONVERSION_ENABLED=false
# When enabled, all of these are required (see infra/document_conversion/AWS_SETUP.md):
# DOCUMENT_REGION=eu-west-1
# DOCUMENT_BUCKET=your-versioned-bucket
# DOCUMENT_TABLE=your-jobs-table
# DOCUMENT_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/ACCOUNT/QUEUE
# DOCUMENT_DLQ_URL=https://sqs.eu-west-1.amazonaws.com/ACCOUNT/DLQ
# DOCUMENT_COGNITO_POOL_ID=eu-west-1_POOL
# DOCUMENT_COGNITO_CLIENT_ID=CLIENT
# DOCUMENT_ORIGIN=https://documents.example.com
# DOCUMENT_ACTIVE_JOBS=2
# DOCUMENT_JOB_WORKERS=2
# DOCUMENT_PAGE_WORKERS=1
# DOCUMENT_MAX_PDF_MIB=25
